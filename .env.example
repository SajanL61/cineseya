# Application
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:4001
NEXT_PUBLIC_SITE_NAME=CineSeya.lk
MONGODB_URI=
MONGODB_DB=cinerusubs
SESSION_SECRET=replace-with-at-least-32-random-characters
DOWNLOAD_SIGNING_SECRET=replace-with-a-different-long-random-secret
CINESEYA_DEMO_MODE=false

# Cloudflare R2 (server only; never prefix these with NEXT_PUBLIC_)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_MEDIA_BUCKET=cineseya-media
R2_ASSETS_BUCKET=cineseya-assets
# Public origin for R2 artwork such as posters/backdrops.
# Production: https://assets.cineseya.lk
PUBLIC_ASSET_DOMAIN=https://assets.cineseya.lk
# Optional private-download worker origin. Required only when the worker is enabled.
DOWNLOAD_DOMAIN=
DOWNLOAD_WORKER_ENABLED=false

# Adaptive HLS transcoder (enable only on the separate background worker)
TRANSCODE_WORKER_ENABLED=false
TRANSCODE_CONCURRENCY=1
TRANSCODE_TEMP_DIR=/tmp/cineseya-transcode
TRANSCODE_PROFILE_VERSION=1
TRANSCODE_MAX_ATTEMPTS=2
TRANSCODE_SEGMENT_SECONDS=6
TRANSCODE_POLL_INTERVAL_MS=5000
# Fixed playback-session lifetime; must cover a normal feature film.
STREAM_SESSION_TTL_SECONDS=14400

# Optional integrations
TMDB_API_TOKEN=
NEXT_PUBLIC_TMDB_ATTRIBUTION_ENABLED=true
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# One-time administrator creation (clear after use)
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
