{
  "name": "cineseya",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 4001",
    "dev:demo": "tsx scripts/demo.ts",
    "build": "next build",
    "start": "next start -p 4001",
    "worker:transcode": "node --import tsx scripts/transcode-worker.ts",
    "worker:transcode:local": "node --env-file=.env.local --import tsx scripts/transcode-worker.ts",
    "seed": "tsx scripts/seed.ts",
    "sync-indexes": "node --env-file=.env.local --import tsx scripts/sync-indexes.ts",
    "test-db": "node --env-file=.env.local --import tsx scripts/test-db-connection.ts",
    "create-super-admin": "node --env-file=.env.local --import tsx scripts/create-super-admin.ts",
    "audit-public-assets": "node --env-file=.env.local --import tsx scripts/audit-public-asset-urls.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.910.0",
    "@aws-sdk/s3-request-presigner": "^3.910.0",
    "argon2": "^0.44.0",
    "hls.js": "^1.6.13",
    "jszip": "^3.10.1",
    "lucide-react": "^0.544.0",
    "mongoose": "^8.18.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.20.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.8",
    "mongodb-memory-server": "^10.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.2",
    "vitest": "^5.0.2"
  }
}
